# Dashboard configuration
# This file is normally generated automatically by scripts/deploy-dashboard.sh
# from your deployed CDK stack outputs. Copy it to `.env` and fill in the values
# from your own deployment if you need to run the dashboard locally.
#
# Do NOT commit your real .env — it contains identifiers for your specific
# AWS deployment. Only this .env.example (with placeholders) is tracked in git.

VITE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/v1/
VITE_WS_URL=wss://<ws-api-id>.execute-api.<region>.amazonaws.com/v1
VITE_USER_POOL_ID=<region>_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_IDENTITY_POOL_ID=<region>:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AWS_REGION=us-east-1
