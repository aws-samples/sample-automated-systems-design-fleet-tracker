{
  "name": "fleet-tracking-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Real-time GPS fleet tracking platform built on AWS IoT Core, Kinesis, Lambda, Location Service, and API Gateway",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "simulator:start": "./scripts/start-simulator.sh",
    "simulator:demo": "PUBLISH_INTERVAL=5000 ./scripts/start-simulator.sh",
    "simulator:production": "PUBLISH_INTERVAL=30000 LOCATION_PROXIMITY_FILTER=true ./scripts/start-simulator.sh"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "mqtt": "^5.15.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
