# ---- Dependencies (regenerated via `npm install` from package-lock.json) ----
node_modules/

# ---- Build / compiled output ----
dist/
build/
*.tsbuildinfo

# ---- AWS CDK synthesis output ----
cdk.out/
*.cdk.staging/

# ---- Environment / local config (generated by scripts/deploy-dashboard.sh) ----
.env
.env.*
!.env.example

# ---- IoT device certificates & private keys (provisioned locally, never commit) ----
# Ignore everything under certs/ EXCEPT the public Amazon Root CA.
certs/*
!certs/AmazonRootCA1.pem

# ---- Logs & coverage ----
*.log
npm-debug.log*
coverage/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
.idea/
